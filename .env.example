# Environment Variables - Copy this to backend/.env and fill in values

# LLM
GROQ_API_KEY=your_groq_api_key_here

# Embeddings (Google AI Studio - get from https://aistudio.google.com/apikey)
# Key should start with AIzaSy...
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (from Google Cloud Console)
# Local development: set GOOGLE_REDIRECT_URI to http://localhost:8000/api/auth/google/callback
# Render deployment: you can leave GOOGLE_REDIRECT_URI unset because the backend derives it
# from Render's RENDER_EXTERNAL_URL automatically.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# JWT (generate a random 64-char string)
JWT_SECRET_KEY=change_this_to_a_random_64_char_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_SIZE_MB=50
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
